# ============================================================
# NFT Rent — muhit sozlamalari namunasi
# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring.
# .env NI HECH QACHON GIT'GA JOYLAMANG!
# ============================================================

# --- Umumiy ---
APP_NAME="NFT Rent"
ENV=development                 # development | production
DEBUG=true

# --- Xavfsizlik ---
# Kuchli tasodifiy kalit yarating: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_super_secret_random_key
SESSION_EXPIRE_MINUTES=10080    # 7 kun

# Bitta IP / username uchun login urinishlari soni (rate limit)
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# --- Telegram bot ---
# @BotFather dan oling
BOT_TOKEN=123456789:CHANGE_ME_telegram_bot_token
BOT_USERNAME=NftRentBot

# WebApp ochiladigan HTTPS manzil (bot tugmasida ishlatiladi)
# Dev: ngrok/cloudflared url; Prod: https://sizning-domen.uz
WEBAPP_URL=https://example.com

# Botning boshlanish sahifasi uchun banner rasm (ixtiyoriy).
# Bo'sh qoldirsangiz, bot chiroyli matnli banner yuboradi.
# Masalan: https://sizning-domen.uz/static/img/banner.png
BOT_BANNER_URL=

# --- Admin ---
# Vergul bilan ajratilgan Telegram user ID lar. O'z ID ingizni @userinfobot dan oling.
ADMIN_TELEGRAM_IDS=111111111,222222222

# --- Support ---
# Admin keyin panel orqali o'zgartirishi mumkin; bu boshlang'ich qiymat
DEFAULT_SUPPORT_USERNAME=NftRentSupport

# --- Ma'lumotlar bazasi ---
# Dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./nft_rent.db
# Prod (PostgreSQL) misoli:
# DATABASE_URL=postgresql+asyncpg://nftrent:password@localhost:5432/nftrent

# --- TON kursi (boshlang'ich; admin o'zgartiradi) ---
DEFAULT_TON_UZS_RATE=40000

# --- Marketapp integratsiyasi (hozircha o'chiq) ---
# Haqiqiy rasmiy API topilганда shu yerга sozlanadi.
MARKETAPP_INTEGRATION_ENABLED=false
MARKETAPP_API_BASE=
MARKETAPP_API_KEY=
